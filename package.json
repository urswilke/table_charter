{
    "name": "table_charter",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite --port 4000",
        "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
        "build": "vite build",
        "preview": "vite preview",
        "test": "wdio wdio.conf.js",
        "deploy": "node build/deploy.js",
        "standalone-build": "vite build --config vite.config.standalone.js",
        "standalone-preview": "vite build --config vite.config.standalone.js && start ./dist/index.html",
        "wdio": "wdio run ./wdio.conf.js",
        "prepare": "husky install"
    },
    "dependencies": {
        "@observablehq/plot": "^0.6.13",
        "compress-json": "^3.0.0",
        "d3": "^7.8.5",
        "immer": "^10.0.3",
        "lit-translate": "^2.0.1",
        "lodash": "^4.17.21",
        "tachyons": "^4.12.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.19.3/xlsx-0.19.3.tgz"
    },
    "devDependencies": {
        "@wdio/browser-runner": "^8.29.7",
        "@wdio/cli": "^8.29.7",
        "@wdio/mocha-framework": "^8.29.3",
        "@wdio/spec-reporter": "^8.29.7",
        "chromedriver": "^121.0.0",
        "fs-extra": "^11.2.0",
        "geckodriver": "^4.3.2",
        "husky": "^9.0.11",
        "lint-staged": "^15.2.2",
        "lit": "^3.1.2",
        "nyc": "^15.1.0",
        "prettier": "^3.2.5",
        "selenium-assistant": "^6.1.1",
        "terser": "^5.26.0",
        "vite": "^4.5.2",
        "vite-plugin-singlefile": "^0.13.5"
    },
    "lint-staged": {
        "*.{js,css,md}": "prettier --write"
    }
}
