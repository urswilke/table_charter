{
    "name": "table_charter",
    "version": "1.2.4",
    "license": "AGPL-3.0-or-later",
    "type": "module",
    "main": "./src/index.js",
    "module": "./src/index.js",
    "unpkg": "dist/main.es.js",
    "exports": {
        ".": "./src/index.js"
    },
    "repository": {
        "type": "git",
        "url": "https://gitlab.com/urswilke/table_charter.git"
    },
    "files": [
        "dist/**/*.js",
        "src/**/*.js",
        "src/**/*.json"
    ],
    "scripts": {
        "dev": "vite --port 4000",
        "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,html}\"",
        "build": "vite build",
        "preview": "vite preview",
        "test": "wdio wdio.conf.js",
        "deploy": "node build/deploy.js",
        "standalone-build": "vite build --config vite.config.standalone.js",
        "standalone-preview": "vite build --config vite.config.standalone.js && start ./dist/index.html",
        "wdio": "wdio run ./wdio.conf.js",
        "prepublishOnly": "rollup -c"
    },
    "dependencies": {
        "@observablehq/plot": "^0.6.15",
        "d3": "^7.9.0",
        "immer": "^10.1.1",
        "intro.js": "^7.2.0",
        "lit-translate": "^2.0.1",
        "tabulator-tables": "^6.2.1"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^25.0.8",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^5.0.7",
        "@wdio/browser-runner": "^8.38.3",
        "@wdio/cli": "^8.38.2",
        "@wdio/mocha-framework": "^8.29.3",
        "@wdio/spec-reporter": "^8.38.2",
        "chromedriver": "^121.0.2",
        "fs-extra": "^11.2.0",
        "geckodriver": "^4.4.1",
        "husky": "^9.0.11",
        "lint-staged": "^15.2.7",
        "lit": "^3.1.4",
        "nyc": "^15.1.0",
        "prettier": "^3.3.2",
        "rollup": "^4.18.0",
        "selenium-assistant": "^6.1.1",
        "terser": "^5.31.1",
        "vite": "^5.3.1",
        "vite-plugin-singlefile": "^0.13.5"
    },
    "lint-staged": {
        "*.{js,css,md}": "prettier --write"
    }
}
